APP_NAME=NexTalk
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Used by VerifyEmailNotification/ResetPasswordNotification to build links
# back to the Next.js app instead of Laravel's default (nonexistent in this
# API-only project) web routes. Also requires adding this line to
# config/app.php: 'frontend_url' => env('FRONTEND_URL', 'http://localhost:3000'),
FRONTEND_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nextalk
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Laravel Reverb (WebSocket server) ─────────────────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ── File storage — spec requires object storage, never local/MySQL ─
FILESYSTEM_DISK=s3
# Spatie Media Library (avatars) uses this disk; defaults to FILESYSTEM_DISK
# above if left unset, but set explicitly if you ever want avatars on a
# different disk/bucket than message attachments.
MEDIA_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# If using an S3-compatible provider (Backblaze, Cloudflare R2, MinIO), set:
# AWS_ENDPOINT=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@nextalk.test"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost:3000

# ── TURN/STUN (Coturn in production) ───────────────────────────────
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=turn:your-coturn-host:3478
TURN_USERNAME=
TURN_CREDENTIAL=
